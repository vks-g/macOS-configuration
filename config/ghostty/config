# Ghostty — ported from kitty.conf (Arch / Hyprland setup)
# Opacity/blur changes need a full Ghostty restart (Cmd+Q, reopen).

# ───────── Font ─────────
# kitty: font_size 11 on a 96-DPI Linux screen ≈ 14.7px → 14 on macOS
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# ───────── Window ─────────
# Matches the SketchyBar pills: #1e1e2e at 85% (PILL_BG=0xd91e1e2e)
# (kitty used 0.75)
background-opacity = 0.85
background-opacity-cells = true
background-blur = true

# kitty: window_padding_width 12
window-padding-x = 12
window-padding-y = 12

# kitty: hide_window_decorations yes (keeps rounded corners)
macos-titlebar-style = hidden

# No macOS shadow/outline around the window (the thin light edge)
macos-window-shadow = false

# ───────── Cursor ─────────
# kitty: cursor_shape beam, cursor_blink_interval 0.5
cursor-style = bar
cursor-style-blink = true

# ───────── Catppuccin Mocha (exact kitty colours) ─────────
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #f5e0dc
selection-foreground = #1e1e2e

# black
palette = 0=#45475a
palette = 8=#585b70
# red
palette = 1=#f38ba8
palette = 9=#f38ba8
